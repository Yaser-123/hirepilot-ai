# HirePilot AI Environment Configuration

# --- 1. Cloud Inference: OpenRouter (Default) ---
# Get free key at: https://openrouter.ai/
OPENROUTER_API_KEY=
PRIMARY_MODEL=google/gemma-4-31b-it:free
# Multi-Tier Fallback Models (comma-separated in priority order)
FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free

# --- 2. Cloud Inference: DigitalOcean GenAI (Alternative / Fallback) ---
# If you have a DigitalOcean GenAI Model Access Key:
DIGITALOCEAN_API_KEY=
DIGITALOCEAN_ENDPOINT=https://inference.do-ai.run/v1
DIGITALOCEAN_MODEL=gemma-4-31B-it

# --- 3. Local Inference: Ollama (Offline Fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- 4. Web Intelligence: Company Research ---
# Optional: Tavily Search API Key (if empty, falls back to DuckDuckGo live search)
TAVILY_API_KEY=
